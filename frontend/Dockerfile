# Estate Platform web — Cloud Run image.
#
# IMPORTANT: build this from the REPOSITORY ROOT, not from frontend/:
#
#   docker build -f frontend/Dockerfile -t estate-web .
#
# `frontend/src/contracts/` is generated by `npm run contracts:sync` and is
# gitignored (Section 9.4), so it does not exist in a fresh checkout. The build
# has to copy `backend/src/contracts/` and the sync script and regenerate it,
# which means the backend tree must be inside the build context.
#
# Vite inlines VITE_* variables at build time, so the API base URL and the Maps
# key are BUILD arguments, not runtime environment. Changing either needs a
# rebuild — there is no way to override them on a running container.

# ---------- build ----------
FROM node:20-bookworm-slim AS build

WORKDIR /repo

# BuildKit warns `SecretsUsedInArgOrEnv` about the key below. That warning does
# not apply here and should not be "fixed": the browser Maps key is inherently
# public — Vite inlines it into a bundle any visitor can read. It is protected by
# an HTTP referrer restriction (Section 7.3), not by secrecy. The *server*
# geocoding key is the confidential one, and it never enters this image; it
# reaches the API from Secret Manager at runtime.
ARG VITE_API_BASE_URL
ARG VITE_GOOGLE_MAPS_API_KEY=""
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_GOOGLE_MAPS_API_KEY=$VITE_GOOGLE_MAPS_API_KEY

# Contracts first: they change less often than feature code, and the sync has to
# happen before the frontend build can resolve `@/contracts/...`.
COPY backend/src/contracts ./backend/src/contracts
COPY backend/scripts/sync-contracts.js ./backend/scripts/sync-contracts.js

COPY frontend/package.json frontend/package-lock.json ./frontend/
RUN npm --prefix frontend ci

RUN node backend/scripts/sync-contracts.js

COPY frontend/ ./frontend/
# The copy above would clobber the generated tree if the host had one, so
# regenerate and then prove the two trees agree before spending a build on them.
RUN node backend/scripts/sync-contracts.js \
  && node backend/scripts/sync-contracts.js --check

RUN npm --prefix frontend run build

# ---------- runtime ----------
FROM nginx:1.27-alpine AS runtime

# nginx's default site listens on 80; Cloud Run requires $PORT (8080 by
# default). The config is a template so the port stays configurable rather than
# baked in — nginx:alpine expands /etc/nginx/templates/*.template on startup.
ENV PORT=8080

COPY frontend/nginx.conf.template /etc/nginx/templates/default.conf.template
# Included by every location block in the template above — see the comment there.
COPY frontend/security-headers.conf /etc/nginx/security-headers.conf
COPY --from=build /repo/frontend/dist /usr/share/nginx/html

EXPOSE 8080

# nginx:alpine's entrypoint runs envsubst over the templates, then execs nginx.
CMD ["nginx", "-g", "daemon off;"]
