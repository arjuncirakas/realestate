# Served by nginx:alpine, which runs envsubst over this template at startup so
# ${PORT} becomes whatever Cloud Run injects.
#
# Every location `include`s security-headers.conf. That repetition is required,
# not accidental: nginx's `add_header` does not merge, so a location declaring
# its own Cache-Control discards any header set at server level. Adding a new
# location without that include silently drops the security headers for it.

server {
  listen       ${PORT};
  server_name  _;
  root         /usr/share/nginx/html;
  index        index.html;

  # Never cache the entry document. Vite fingerprints every asset, so a stale
  # index.html is the one file that can pin a browser to a deleted bundle.
  location = /index.html {
    include /etc/nginx/security-headers.conf;
    add_header Cache-Control "no-store, must-revalidate" always;
    try_files $uri =404;
  }

  # Fingerprinted assets are immutable by construction — the filename changes
  # when the content does. A missing one must 404 rather than fall through to
  # the SPA, or a broken import returns HTML and fails with a confusing MIME
  # error in the browser.
  location /assets/ {
    include /etc/nginx/security-headers.conf;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    try_files $uri =404;
  }

  # SPA fallback: react-router owns the path space, so any unmatched path has to
  # reach index.html rather than 404 at the edge. Without this a hard refresh on
  # /properties/some-slug returns nginx's 404 instead of the app.
  location / {
    include /etc/nginx/security-headers.conf;
    try_files $uri $uri/ /index.html;
  }

  gzip on;
  gzip_types text/plain text/css application/javascript application/json image/svg+xml;
  gzip_min_length 1024;

  # Cloud Run terminates TLS and logs requests itself; nginx access logs would
  # only duplicate them.
  access_log off;
}
