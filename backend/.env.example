NODE_ENV=development
PORT=4000
# Host port is 5433 (not the 5432 in Section 8.1) because docker-compose.yml
# publishes PostGIS on 5433 to avoid a clash with another local Postgres.
DATABASE_URL=postgresql://estate:estate@localhost:5433/estate_dev
JWT_ACCESS_SECRET=change-me-min-32-chars-change-me-min
JWT_REFRESH_SECRET=change-me-different-min-32-chars-abc
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGIN=http://localhost:5173
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./uploads
PUBLIC_UPLOAD_BASE_URL=http://localhost:4000/uploads
GCS_BUCKET=
GCS_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
GEOCODING_API_KEY=
LOG_LEVEL=debug
